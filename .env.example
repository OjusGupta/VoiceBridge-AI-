# VoiceBridge AI — Environment Variables
# Copy this file to .env and fill in values as needed.

# Optional: OpenAI-compatible API key for LLM mode
# Leave empty or remove to use local demo mode
OPENAI_API_KEY=

# Optional: Base URL for OpenAI-compatible API (e.g., for local models)
OPENAI_BASE_URL=

# Optional: Model name to use (default: gpt-3.5-turbo)
LLM_MODEL_NAME=gpt-3.5-turbo

# Optional: LLM request timeout in seconds (default: 15)
LLM_TIMEOUT=15
